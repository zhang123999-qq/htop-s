#===============================================================================
# 21. 环境自检
#===============================================================================
CHK_FAIL=0
CHK_SKIP=0

chk() {
    local label="$1" val="$2" st="$3" note="$4" color="$C_GREEN"
    case "$st" in
        SKIP) color="$C_DIM"; CHK_SKIP=$(( CHK_SKIP + 1 )) ;;
        FAIL) color="$C_RED"; CHK_FAIL=$(( CHK_FAIL + 1 )) ;;
    esac
    printf '  %s%-11s%s %-30s %s%-4s%s %s\n' "$C_DIM" "$label" "$C_RESET" "$val" "$color" "$st" "$C_RESET" "${note:-}"
}

do_check() {
    term_width
    printf '%s\n' "$(hr_line "$TERM_COLS")"
    printf '  %s%s\n' "$(bold "$PROG 环境自检 v$VERSION")" ""
    printf '%s\n' "$(hr_line "$TERM_COLS")"

    # 系统
    local os k
    os=$(read_os)
    k=$(uname -r 2>/dev/null || echo "?")
    chk "系统" "$(uname -s 2>/dev/null || echo '?') $k $(uname -m 2>/dev/null || echo '?')" "OK" ""
    chk "发行版" "$os" "OK" ""

    # bash
    local bv="${BASH_VERSION:-unknown}"
    case "$bv" in
        3.*|4.*|5.*|6.*|7.*|8.*) chk "bash" "$bv" "OK" "需要 >= 3.2" ;;
        *) chk "bash" "$bv" "FAIL" "需要 >= 3.2" ;;
    esac

    # awk
    local av
    av=$(awk 'BEGIN{print "ok"}' 2>/dev/null)
    if [ "$av" = "ok" ]; then
        av=$(awk --version 2>/dev/null | head -1)
        [ -z "$av" ] && av="busybox awk 或其它 POSIX awk"
        chk "awk" "$av" "OK" "POSIX 兼容即可"
    else
        chk "awk" "不可用" "FAIL" "本脚本强依赖 awk"
    fi

    # 时钟源
    local up
    up=$(read_uptime)
    if [ "$up" != "0" ] && [ -n "$up" ]; then chk "时钟源" "$PROC_ROOT/uptime $up" "OK" "精度 10ms"; else chk "时钟源" "$PROC_ROOT/uptime" "FAIL" "无法读取"; fi

    chk "页大小" "$PAGESIZE" "OK" ""
    chk "CLK_TCK" "$CLK_TCK" "OK" ""

    # 数据源
    local n
    n=$(read_core_count)
    chk "CPU 核数" "$n" "OK" "来自 $PROC_ROOT/stat"

    n=$(cat "$PROC_ROOT"/[0-9]*/stat 2>/dev/null | wc -l | tr -d ' ')
    is_num "${n:-}" || n=0
    if [ "$n" -gt 0 ]; then chk "进程采集" "$n 个进程" "OK" "$PROC_ROOT/[pid]/stat"; else chk "进程采集" "0" "FAIL" "无进程可读"; fi

    if [ -r "$PROC_ROOT/meminfo" ]; then chk "内存" "$PROC_ROOT/meminfo" "OK" ""; else chk "内存" "缺失" "FAIL" ""; fi

    if command -v df >/dev/null 2>&1; then
        n=$(df -PT 2>/dev/null | wc -l | tr -d ' ')
        chk "磁盘容量" "df -PT" "OK" "$n 行输出"
    else
        chk "磁盘容量" "df 缺失" "FAIL" "磁盘分区将显示 N/A"
    fi

    if [ -r "$PROC_ROOT/diskstats" ]; then
        n=$(disk_whole_list)
        chk "磁盘 IO" "$PROC_ROOT/diskstats" "OK" "整盘: $n"
    else
        chk "磁盘 IO" "缺失" "SKIP" "磁盘 IO 将显示 0"
    fi

    n=$(printf '%s' "$IFACE_LIST" | awk '{print $1}')
    if [ -r "$PROC_ROOT/net/dev" ]; then chk "网卡" "$n ($(iface_ip "$n"))" "OK" ""; else chk "网卡" "缺失" "FAIL" ""; fi

    if [ -r "$PROC_ROOT/net/tcp" ]; then
        local t
        t=$(conn_scan | awk 'NR == 1 { print $2 }')
        chk "TCP 采集" "$PROC_ROOT/net/tcp" "OK" "$t 个连接"
    else
        chk "TCP 采集" "缺失" "FAIL" ""
    fi

    if [ -r "$PROC_ROOT/net/netstat" ]; then chk "协议栈" "$PROC_ROOT/net/netstat" "OK" "表头动态匹配"; else chk "协议栈" "缺失" "SKIP" "重传率等显示 0"; fi
    if [ -r "$PROC_ROOT/net/snmp" ]; then chk "UDP 统计" "$PROC_ROOT/net/snmp" "OK" ""; else chk "UDP 统计" "缺失" "SKIP" "UDP 错误显示 0"; fi

    local ct cm
    read -r ct cm <<< "$(read_conntrack)"
    if [ "${cm:-0}" -gt 0 ] 2>/dev/null; then chk "conntrack" "$ct / $cm" "OK" ""; else chk "conntrack" "模块未加载" "SKIP" "虚拟机常见"; fi

    local tp
    tp=$(read_temp)
    if [ -n "${tp:-}" ]; then chk "温度" "${tp}°C" "OK" ""; else chk "温度" "无热区" "SKIP" "虚拟机常见"; fi

    # nftables
    if [ "$HAS_NFT" = "1" ]; then
        local uid
        uid=$(id -u 2>/dev/null || echo 1)
        if [ "$uid" = "0" ]; then
            if nft_exists; then chk "nftables" "表 inet htop_s 存在" "OK" "增强模式生效中"; else chk "nftables" "nft 可用" "OK" "可执行 --acct on 启用"; fi
        else
            chk "nftables" "需要 root" "SKIP" "非 root 无法创建计数表"
        fi
    else
        chk "nftables" "命令缺失" "SKIP" "使用基础模式 /proc/net/dev"
    fi

    # systemd
    if [ "$HAS_SYSTEMCTL" = "1" ]; then chk "systemd" "可用" "OK" "支持开机自启"; else chk "systemd" "不可用" "SKIP" "无法安装服务"; fi

    # 告警用到的可选外部命令
    if [ "$HAS_PING" = "1" ]; then chk "ping" "可用" "OK" "支持 netdown 断网告警"; else chk "ping" "不可用" "SKIP" "netdown 规则自动跳过"; fi
    if [ "$HAS_CURL" = "1" ]; then chk "curl" "可用" "OK" "支持 --check-update/--update"
    elif [ "$HAS_WGET" = "1" ]; then chk "wget" "可用" "OK" "支持 --check-update/--update"
    else chk "下载工具" "均不可用" "SKIP" "不影响监控, 仅无法在线更新"; fi
    if [ -r "$PROC_ROOT/net/route" ]; then
        local gw
        gw=$(read_gateway)
        if [ -n "$gw" ]; then chk "默认网关" "$gw" "OK" ""; else chk "默认网关" "未找到" "SKIP" "netdown 规则自动跳过"; fi
    else
        chk "默认网关" "缺失" "SKIP" "$PROC_ROOT/net/route 不可读"
    fi

    # 终端能力
    local cols
    cols=${COLUMNS:-$(stty size 2>/dev/null | awk '{print $2}')}
    is_num "${cols:-}" || cols=0
    if [ "$cols" -ge 80 ] 2>/dev/null; then chk "终端宽度" "${cols} 列" "OK" ""
    elif [ "$cols" -gt 0 ]; then chk "终端宽度" "${cols} 列" "SKIP" "建议 >= 80, 将进入紧凑模式"
    else chk "终端宽度" "非交互" "SKIP" "重定向输出, 键盘交互禁用"; fi

    printf '%s\n' "$(hr_line "$TERM_COLS")"
    if [ "$CHK_FAIL" = "0" ] && [ "$CHK_SKIP" = "0" ]; then
        printf '  %s%s%s\n' "$C_GREEN" "结论: 全部功能可用" "$C_RESET"
    elif [ "$CHK_FAIL" = "0" ]; then
        printf '  %s%s%s\n' "$C_GREEN" "结论: 核心功能可用, $CHK_SKIP 项因环境缺失自动降级 (见上方 SKIP 说明)" "$C_RESET"
    else
        printf '  %s%s%s\n' "$C_RED" "结论: $CHK_FAIL 项不可用, 对应分区会降级显示 N/A" "$C_RESET"
    fi
    printf '  流量计数模式: %s\n' "$ST_MODE"
    return 0
}


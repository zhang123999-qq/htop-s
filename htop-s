config_set() {
    local k="$1" v="$2" tmp
    mkdir -p "${CONF_FILE%/*}" 2>/dev/null
    tmp="${CONF_FILE}.tmp.$$"
    if [ -f "$CONF_FILE" ]; then
        awk -v k="$k" -v v="$v" '
            { p = index($0, "="); key = substr($0, 1, p - 1)
              if (p > 0 && key == k) { print k "=" v; found = 1; next }
              print
            }
            END { if (!found) print k "=" v }
        ' "$CONF_FILE" > "$tmp" 2>/dev/null && mv -f "$tmp" "$CONF_FILE" 2>/dev/null
    else
        printf '%s=%s\n' "$k" "$v" > "$tmp" 2>/dev/null && mv -f "$tmp" "$CONF_FILE" 2>/dev/null
    fi
    return 0
}

parse_size() {
    # 输入 1024G / 500M / 2T / 1024 -> 字节数
    local s="$1" num unit
    case "$s" in
        ''|*[!0-9KkMmGgTt]*) return 1 ;;
    esac
    unit=$(printf '%s' "$s" | sed 's/.*[0-9]//' 2>/dev/null)
    num=$(printf '%s' "$s" | sed 's/[^0-9]//g' 2>/dev/null)
    is_num "${num:-}" || return 1
    case "$unit" in
        T|t) num=$(( num * 1099511627776 )) ;;
        G|g) num=$(( num * 1073741824 )) ;;
        M|m) num=$(( num * 1048576 )) ;;
        K|k) num=$(( num * 1024 )) ;;
    esac
    printf '%s' "$num"
    return 0
}


#===============================================================================
# 17. 交互循环
#===============================================================================
enter_screen() {
    [ "$IS_TTY" = "1" ] || return 0
    if [ "$HAS_STTY" = "1" ]; then
        SAVED_STTY=$(stty -g 2>/dev/null) || SAVED_STTY=""
        stty -icanon -echo min 0 time 1 2>/dev/null
    fi
    printf '\033[?1049h\033[?25l\033[H'
    return 0
}

leave_screen() {
    [ "$IS_TTY" = "1" ] || return 0
    if [ "$HAS_STTY" = "1" ]; then
        [ -n "$SAVED_STTY" ] && stty "$SAVED_STTY" 2>/dev/null
        stty sane 2>/dev/null
    fi
    printf '\033[?25h\033[0m\033[?1049l'
    return 0
}

cleanup_all() {
    leave_screen
    [ -n "${TMPD:-}" ] && rm -rf "$TMPD" 2>/dev/null
    exit 0
}

read_key() {
    [ "$IS_TTY" = "1" ] || return 0
    local k
    k=$(dd bs=1 count=1 2>/dev/null)
    case "$k" in
        q|Q) return 1 ;;
        ' ')
            if [ "$PAUSED" = "1" ]; then PAUSED=0; else PAUSED=1; fi ;;
        r|R) : ;;
        c|C) CV_PROC_MODE="c"; MV_PROCS=$(proc_top "c" 10); proc_enrich ;;
        m|M) CV_PROC_MODE="m"; MV_PROCS=$(proc_top "m" 10); proc_enrich ;;
        n|N) CV_PROC_MODE="n"; MV_CONNMAP=$(proc_conn_map); MV_PROCS=$(proc_top "n" 10); proc_enrich ;;
        i|I) CV_PROC_MODE="i"; MV_IOMAP=$(proc_io_map);     MV_PROCS=$(proc_top "i" 10); proc_enrich ;;
        1)   if [ "$SHOW_CORES" = "1" ]; then SHOW_CORES=0; else SHOW_CORES=1; fi ;;
        p|P)
            if [ "$MV_PORTS_ON" = "1" ]; then
                MV_PORTS_ON=0
            else
                MV_PORTS_ON=1
                MV_PORTS=$(port_map)
            fi
            ;;
        +)   [ "$INTERVAL" -lt 30 ] && INTERVAL=$(( INTERVAL + 1 )) ;;
        -)   [ "$INTERVAL" -gt 1 ] && INTERVAL=$(( INTERVAL - 1 )) ;;
        s|S) snapshot_to_log ;;
        '?') show_help ;;
    esac
    return 0
}

show_help() {
    term_width
    local W=$TERM_COLS
    [ "$W" -gt 110 ] && W=110
    [ "$IS_TTY" = "1" ] && printf '\033[H'
    p_line "$(hr_line "$W")"
    p_line "  ${C_BOLD}${PROG} ${VERSION} — ${T_HELP}${C_RESET}"
    p_line "$(hr_line "$W")"
    p_line "  ${T_KEYS_HELP_1}"
    p_line "  ${T_KEYS_HELP_2}"
    p_line "  ${T_KEYS_HELP_3}"
    p_line "  ${T_KEYS_HELP_4}"
    p_line "$(hr_line "$W")"
    p_line "  ${C_DIM}${T_PRESS_ANY}${C_RESET}"
    dd bs=1 count=1 >/dev/null 2>&1
    return 0
}

snapshot_to_log() {
    local f="$LOG_DIR/snapshot-$(date +%Y%m%d).log"
    mkdir -p "$LOG_DIR" 2>/dev/null
    {
        printf '=== %s ===\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        export_snapshot
        printf '\n'
    } >> "$f" 2>/dev/null
    return 0
}

interactive_loop() {
    local t0 t1 spent remain
    PAUSED=0
    SHOW_CORES=0
    MV_PORTS_ON=0
    sample_slow
    sample_prime
    sleep 1
    sample_fast
    sample_mid
    enter_screen
    trap cleanup_all EXIT INT TERM HUP
    trap 'WINCH=1' WINCH
    WINCH=0
    while :; do
        t0=$(read_uptime)
        if [ "$PAUSED" != "1" ]; then
            dispatch_frames
            quota_update
        fi
        t1=$(read_uptime)
        RENDER_MS=$(awk -v n="$t1" -v p="$t0" 'BEGIN{printf "%.0f", (n-p)*1000}')
        render
        read_key || break
        # 终端尺寸变化 (SIGWINCH): 立刻重绘, 不等待剩余刷新间隔
        if [ "$WINCH" = "1" ]; then
            WINCH=0
            continue
        fi
        if [ "$PAUSED" != "1" ]; then
            spent=$(awk -v n="$(read_uptime)" -v p="$t0" 'BEGIN{printf "%.3f", n-p}')
            remain=$(awk -v i="$INTERVAL" -v s="$spent" 'BEGIN{ r=i-s; if (r < 0) r = 0; printf "%.3f", r }')
            sleep "$remain" 2>/dev/null || sleep 1
        else
            sleep 0.2 2>/dev/null || sleep 1
        fi
    done
    leave_screen
    # 不要把 trap 清空 —— 一旦清空, 本函数用的临时目录将永久残留。
    # 重置为"仅清理目录"的兜底版本即可 (交互期间由 cleanup_all 负责)。
    trap 'rm -rf "${TMPD:-}" 2>/dev/null' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    return 0
}

#===============================================================================
# 18. 后台采集
#===============================================================================
rotate_logs() {
    local today f
    today=$(date +%Y-%m-%d)
    [ "$today" = "$LAST_DATE" ] && return 0
    LAST_DATE="$today"
    ALERT_FILE="$LOG_DIR/alert-$today.log"
    mkdir -p "$LOG_DIR" 2>/dev/null
    for f in "$LOG_DIR"/collect-*.csv; do
        [ -e "$f" ] || continue
        case "$f" in *"$today"*) continue ;; esac
        [ "$HAS_GZIP" = "1" ] && gzip -f "$f" 2>/dev/null
    done
    if command -v find >/dev/null 2>&1; then
        find "$LOG_DIR" -maxdepth 1 -name 'collect-*.csv.gz' -type f -mtime "+${KEEP_DAYS:-30}" -delete 2>/dev/null
        find "$LOG_DIR" -maxdepth 1 -name 'alert-*.log' -type f -mtime "+${KEEP_DAYS:-30}" -delete 2>/dev/null
    fi
    return 0
}

write_csv() {
    local f mempct swappct
    [ -n "$LAST_DATE" ] || return 0
    f="$LOG_DIR/collect-$LAST_DATE.csv"
    mkdir -p "$LOG_DIR" 2>/dev/null
    if [ ! -s "$f" ]; then
        printf '%s\n' "时间,epoch,uptime,cpu,mem,swap,load1,down_bps,up_bps,tcp,udp,disk_rd,disk_wr,rx_err,tx_err,rx_bytes,tx_bytes" > "$f" 2>/dev/null
    fi
    mempct=$(awk -v u="$CV_MEM_USED" -v t="$CV_MEM_TOTAL" 'BEGIN{ printf "%.1f", (t>0)?u/t*100:0 }')
    swappct=$(awk -v u="$CV_SWAP_USED" -v t="$CV_SWAP_TOTAL" 'BEGIN{ printf "%.1f", (t>0)?u/t*100:0 }')
    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$(date +%s)" "${SV_UPTIME%%.*}" \
        "$CV_CPU_TOTAL" "$mempct" "$swappct" "$CV_LOAD1" \
        "$CV_RX_RATE" "$CV_TX_RATE" "$CV_TCP_TOTAL" "$CV_UDP_TOTAL" \
        "$MV_DISK_RD" "$MV_DISK_WR" "$CV_RXERR" "$CV_TXERR" \
        "$CV_NET_DOWN_INC" "$CV_NET_UP_INC" >> "$f" 2>/dev/null
    return 0
}

daemon_loop() {
    mkdir -p "$LOG_DIR" 2>/dev/null
    LAST_DATE=""
    KEEP_DAYS=$(is_num "${KEEP_DAYS:-}" && printf '%s' "$KEEP_DAYS" || printf '30')
    SV_CORES_N=$(read_core_count)
    sample_slow
    sample_prime
    rotate_logs
    sleep 1
    while :; do
        dispatch_frames
        quota_update
        rotate_logs
        write_csv
        state_save
        alert_scan
        sleep "$DAEMON_INTERVAL" 2>/dev/null || sleep 5
    done
}

start_daemon() {
    local pid
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_num "${pid:-}" && kill -0 "$pid" 2>/dev/null; then
            printf '%s %s\n' "${T_ALREADY:-后台采集已在运行, pid:}" "$pid"
            return 1
        fi
        rm -f "$PID_FILE" 2>/dev/null
    fi
    if [ "$HAS_FLOCK" = "1" ]; then
        exec 9>"$LOCK_FILE" 2>/dev/null
        if ! flock -n 9 2>/dev/null; then
            printf '%s\n' "${T_ALREADY:-后台采集已在运行}"
            return 1
        fi
    fi
    mkdir -p "${PID_FILE%/*}" 2>/dev/null
    echo $$ > "$PID_FILE" 2>/dev/null
    trap 'rm -f "$PID_FILE" 2>/dev/null; rm -rf "${TMPD:-}" 2>/dev/null; exit 0' INT TERM EXIT
    printf '%s %s\n' "${T_DAEMON_READY:-后台采集已启动, 日志目录:}" "$LOG_DIR"
    daemon_loop
    return 0
}

#===============================================================================
# 19. 安装 / 卸载 / 服务管理
#===============================================================================
resolve_self() {
    local s="$0"
    case "$s" in
        */*) printf '%s' "$s" ;;
        *) command -v "$PROG" 2>/dev/null || printf '%s/%s' "$(pwd)" "$s" ;;
    esac
}

need_root() {
    if [ "$(id -u 2>/dev/null || echo 1)" != "0" ]; then
        printf '%s\n' "错误: $1 需要 root 权限, 请使用 sudo $PROG $1" >&2
        return 1
    fi
    return 0
}

# 把脚本自身安装到 BIN_PATH。
# 脚本已在目标位置时直接返回成功 —— cp 同一文件会报
# "are the same file" 并返回非 0, 会被误判为写入失败。
# 返回 0 成功; 1 失败 (原因已打印到 stderr)
install_self() {
    local self="$1"
    [ -n "$self" ] || return 1
    if [ "$BIN_PATH" -ef "$self" ] 2>/dev/null; then
        return 0
    fi
    # 目标被运行中的进程占用时覆盖会失败, 先给出可操作的提示
    if [ -f "$BIN_PATH" ] && command -v fuser >/dev/null 2>&1 && \
       fuser "$BIN_PATH" >/dev/null 2>&1; then
        printf '%s\n' "错误: $BIN_PATH 正被占用, 请先停止服务: sudo $PROG --stop" >&2
        return 1
    fi
    if ! cp "$self" "$BIN_PATH" 2>/dev/null; then
        if [ ! -w "${BIN_PATH%/*}" ]; then
            printf '%s\n' "错误: 目录不可写 (${BIN_PATH%/*}), 需要 root 权限" >&2
        else
            printf '%s\n' "错误: 无法写入 $BIN_PATH (磁盘已满或文件系统只读)" >&2
        fi
        return 1
    fi
    return 0
}

do_install() {
    need_root "--install" || return 1
    local self
    self=$(resolve_self)
    if [ ! -r "$self" ]; then
        printf '%s\n' "错误: 无法读取脚本自身 ($self)" >&2
        return 1
    fi
    mkdir -p /usr/local/bin 2>/dev/null
    install_self "$self" || return 1
    if [ "$BIN_PATH" -ef "$self" ] 2>/dev/null; then
        printf '提示: %s 已是当前文件, 无需重复安装\n' "$BIN_PATH"
    else
        printf '已安装: %s\n' "$BIN_PATH"
    fi
    chmod 755 "$BIN_PATH" 2>/dev/null

    mkdir -p "$CONFIG_DIR" /var/lib/htop-s "$LOG_DIR" 2>/dev/null
    if [ ! -f "$CONF_FILE" ]; then
        {
            printf '# htop-s 配置\n'
            printf 'iface=%s\n' "${IFACE_LIST%% *}"
            printf 'interval=5\n'
            printf 'quota=%s\n' "${ST_QUOTA:-0}"
            printf 'reset_day=%s\n' "${ST_RESET_DAY:-1}"
            printf 'keep_days=30\n'
            printf 'acct=proc\n'
        } > "$CONF_FILE" 2>/dev/null
    fi
    if [ ! -f "$STATE_FILE" ]; then
        ST_PERIOD_START=$(period_start "${ST_RESET_DAY:-1}")
        ST_MODE="proc"
        state_save
    fi

    if [ "$HAS_SYSTEMCTL" != "1" ]; then
        printf '%s\n' "警告: 未检测到 systemd, 无法安装开机自启。" >&2
        printf '%s\n' "可手动后台运行: nohup $BIN_PATH --daemon >/dev/null 2>&1 &" >&2
        return 1
    fi

    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=htop-s server monitor daemon
After=network-pre.target local-fs.target
Wants=network-pre.target
ConditionPathExists=$BIN_PATH

[Service]
Type=simple
ExecStart=$BIN_PATH --daemon
ExecStartPost=$BIN_PATH --ensure-acct
ExecReload=/bin/kill -HUP \$MAINPID
Restart=always
RestartSec=3
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
MemoryMax=64M
CPUQuota=10%
LimitNOFILE=4096
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
    if [ ! -s "$SERVICE_FILE" ]; then
        printf '%s\n' "错误: 无法写入 $SERVICE_FILE" >&2
        return 1
    fi

    if [ "$OPT_WITH_MOTD" = "1" ]; then
        cat > "$MOTD_FILE" <<EOF
# htop-s 登录提示
if [ -n "\$PS1" ] && [ -x $BIN_PATH ]; then
    echo "提示: 输入 htop-s 查看服务器实时监控"
fi
EOF
        chmod 644 "$MOTD_FILE" 2>/dev/null
    fi

    systemctl daemon-reload 2>/dev/null
    systemctl enable htop-s.service 2>/dev/null
    systemctl restart htop-s.service 2>/dev/null
    sleep 1
    if systemctl is-active htop-s.service >/dev/null 2>&1; then
        printf '%s\n' "安装成功: $BIN_PATH -> htop-s.service (已启动, 开机自启)"
    else
        printf '%s\n' "服务已安装但未成功启动, 请检查: journalctl -u htop-s -n 30" >&2
    fi
    printf '%s\n' "状态: $PROG --status   日志: $PROG --log   卸载: sudo $PROG --uninstall"
    return 0
}

do_uninstall() {
    need_root "--uninstall" || return 1
    if [ "$HAS_SYSTEMCTL" = "1" ]; then
        systemctl disable --now htop-s.service 2>/dev/null
        rm -f "$SERVICE_FILE" 2>/dev/null
        systemctl daemon-reload 2>/dev/null
        printf '%s\n' "已移除 systemd 服务 htop-s.service"
    fi
    nft_delete
    rm -f "$MOTD_FILE" 2>/dev/null
    if [ "$OPT_PURGE" = "1" ]; then
        rm -rf /var/lib/htop-s /var/log/htop-s "$CONFIG_DIR" 2>/dev/null
        printf '%s\n' "已清理状态、日志与配置"
    fi
    rm -f "$BIN_PATH" 2>/dev/null && printf '%s\n' "已删除 $BIN_PATH"
    [ "$OPT_PURGE" != "1" ] && printf '%s\n' "注意: 日志/状态/配置已保留, 彻底清理请加 --purge"
    return 0
}

do_upgrade() {
    need_root "--upgrade" || return 1
    local self
    self=$(resolve_self)
    [ -r "$self" ] || { printf '%s\n' "错误: 无法读取脚本自身" >&2; return 1; }
    if ! bash -n "$self" 2>/dev/null; then
        printf '%s\n' "错误: 新版本语法检查未通过, 已中止升级" >&2
        return 1
    fi
    if [ "$BIN_PATH" -ef "$self" ] 2>/dev/null; then
        printf '提示: %s 已是当前文件, 无需升级\n' "$BIN_PATH"
    else
        [ -f "$BIN_PATH" ] && cp "$BIN_PATH" "$BIN_PATH.bak" 2>/dev/null
        install_self "$self" || return 1
        chmod 755 "$BIN_PATH" 2>/dev/null
    fi
    if [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ]; then
        systemctl daemon-reload 2>/dev/null
        systemctl restart htop-s.service 2>/dev/null
    fi
    printf '%s\n' "升级完成 (旧版备份在 $BIN_PATH.bak)"
    return 0
}

svc_start() {
    need_root "--start" || return 1
    if [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ]; then
        systemctl start htop-s.service 2>/dev/null && printf '%s\n' "已启动 htop-s.service"
    else
        printf '%s\n' "未安装服务, 请先执行: sudo $PROG --install" >&2
        return 1
    fi
    return 0
}

svc_stop() {
    need_root "--stop" || return 1
    if [ "$HAS_SYSTEMCTL" = "1" ] && systemctl is-active htop-s.service >/dev/null 2>&1; then
        systemctl stop htop-s.service 2>/dev/null && printf '%s\n' "已停止 htop-s.service"
    else
        printf '%s\n' "服务未在运行"
    fi
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_num "${pid:-}" && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null && printf '%s\n' "已停止后台采集进程 (pid $pid)"
        fi
        rm -f "$PID_FILE" 2>/dev/null
    fi
    printf '%s\n' "注意: nftables 计数规则已保留, 避免流量统计断点"
    return 0
}

svc_restart() {
    need_root "--restart" || return 1
    if [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ]; then
        systemctl restart htop-s.service 2>/dev/null && printf '%s\n' "已重启 htop-s.service"
    else
        printf '%s\n' "未安装服务" >&2
        return 1
    fi
    return 0
}

do_status() {
    local svc="未安装" act="停止" en="disabled"
    if [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ]; then
        svc="已安装"
        systemctl is-active htop-s.service >/dev/null 2>&1 && act="运行中" || act="已停止"
        systemctl is-enabled htop-s.service >/dev/null 2>&1 && en="enabled (开机自启)" || en="disabled"
    fi
    printf '%s\n' "=== ${PROG} ${VERSION} 状态 ==="
    printf '  %-12s %s\n' "systemd 服务" "$svc"
    printf '  %-12s %s\n' "运行状态" "$act"
    printf '  %-12s %s\n' "开机自启" "$en"
    local pids="未运行"
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if is_num "${pid:-}" && kill -0 "$pid" 2>/dev/null; then pids="运行中 (pid $pid)"; else pids="已停止 (残留 pid 文件)"; fi
    fi
    printf '  %-12s %s\n' "采集进程" "$pids"
    printf '  %-12s %s\n' "日志目录" "$LOG_DIR"
    if [ -d "$LOG_DIR" ]; then
        local n sz
        n=$(ls -1 "$LOG_DIR" 2>/dev/null | wc -l | tr -d ' ')
        sz=$(du -sh "$LOG_DIR" 2>/dev/null | awk '{print $1}')
        printf '  %-12s %s 个文件, 共 %s\n' "日志" "${n:-0}" "${sz:-?}"
    fi
    if [ -n "$ST_PERIOD_START" ]; then
        printf '  %-12s %s (重置日 %s)\n' "计量周期" "$ST_PERIOD_START" "$ST_RESET_DAY"
    fi
    if [ "${ST_QUOTA:-0}" -gt 0 ] 2>/dev/null; then
        printf '  %-12s %s\n' "月配额" "$(human_bytes "$ST_QUOTA")"
    else
        printf '  %-12s %s\n' "月配额" "未设置"
    fi
    if [ "$HAS_NFT" = "1" ]; then
        if nft_exists; then printf '  %-12s %s\n' "流量计数" "nftables 增强模式 (表 inet htop_s)"; else printf '  %-12s %s\n' "流量计数" "未启用 (可执行 --acct on)"; fi
    else
        printf '  %-12s %s\n' "流量计数" "基础模式 (无 nft 命令)"
    fi
    printf '  %-12s %s\n' "状态文件" "$STATE_FILE"
    printf '  %-12s %s\n' "配置文件" "$CONF_FILE"
    return 0
}

do_acct() {
    local v="$1"
    case "$v" in
        on)
            need_root "--acct on" || return 1
            if [ "$HAS_NFT" != "1" ]; then printf '%s\n' "错误: 未找到 nft 命令, 无法启用增强模式" >&2; return 1; fi
            [ -z "$IFACE_LIST" ] && IFACE_LIST=$(iface_detect)
            if nft_create; then
                ST_MODE="nft"
                ST_NFT_RX_LAST=0; ST_NFT_TX_LAST=0
                config_set acct nft
                state_save
                printf '%s\n' "已启用 nftables 增强模式 (独立表 inet htop_s, 不影响现有防火墙规则)"
                [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ] && systemctl restart htop-s.service 2>/dev/null
            else
                printf '%s\n' "错误: 创建 nftables 表失败 (需要 root 且内核支持)" >&2
                return 1
            fi
            ;;
        off)
            need_root "--acct off" || return 1
            nft_delete
            ST_MODE="proc"
            config_set acct proc
            state_save
            printf '%s\n' "已关闭增强模式, 已删除自建表 inet htop_s"
            [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ] && systemctl restart htop-s.service 2>/dev/null
            ;;
        status|'')
            if [ "$HAS_NFT" != "1" ]; then
                printf '%s\n' "流量计数模式: 基础模式 (/proc/net/dev)"
                printf '%s\n' "原因: 本机没有 nft 命令"
            elif nft_exists; then
                local r
                r=$(nft_read)
                printf '%s\n' "流量计数模式: nftables 增强模式"
                printf '  表 inet htop_s   入站 %s   出站 %s\n' \
                    "$(human_bytes "$(printf '%s' "$r" | awk '{print $1}')")" \
                    "$(human_bytes "$(printf '%s' "$r" | awk '{print $2}')")"
            else
                printf '%s\n' "流量计数模式: 基础模式 (/proc/net/dev)"
                printf '%s\n' "可执行 sudo $PROG --acct on 启用增强模式 (跨服务器重启不丢流量)"
            fi
            ;;
        *) printf '%s\n' "用法: $PROG --acct on|off|status" >&2; return 1 ;;
    esac
    return 0
}

do_ensure_acct() {
    [ "${ST_MODE:-proc}" != "nft" ] && return 0
    [ "$HAS_NFT" != "1" ] && return 0
    [ -z "$IFACE_LIST" ] && IFACE_LIST=$(iface_detect)
    nft_exists && return 0
    nft_create && printf '%s\n' "已重建 nftables 计数表"
    return 0
}

#===============================================================================
# 20. 查询命令
#===============================================================================
csv_hb() {
    awk '{
        v = $1 + 0
        if (v >= 1099511627776) { r = v % 1099511627776; u = v / 1099511627776; printf "%d.%dTB", u, r * 10 / 1099511627776 }
        else if (v >= 1073741824) { r = v % 1073741824; u = v / 1073741824; printf "%d.%dGB", u, r * 10 / 1073741824 }
        else if (v >= 1048576) { r = v % 1048576; u = v / 1048576; printf "%d.%dMB", u, r * 10 / 1048576 }
        else if (v >= 1024) { r = v % 1024; u = v / 1024; printf "%d.%dKB", u, r * 10 / 1024 }
        else printf "%dB", v
    }'
}

do_log() {
    local n="$1" f
    if [ ! -d "$LOG_DIR" ]; then
        printf '%s\n' "暂无采集日志 (目录尚未创建: $LOG_DIR)"
        printf '%s\n' "请先启动后台采集: sudo $PROG --install"
        return 0
    fi
    f=$(ls -1t "$LOG_DIR"/collect-*.csv* 2>/dev/null | head -1)
    if [ -z "$f" ]; then
        printf '%s\n' "暂无采集日志。请先启动后台采集: sudo $PROG --install"
        return 0
    fi
    printf '%s\n' "采集日志: $f"
    case "$f" in
        *.gz) gzip -dc "$f" 2>/dev/null | tail -n "$n" ;;
        *)    tail -n "$n" "$f" 2>/dev/null ;;
    esac
    printf '\n%s\n' "提示: $PROG --log 200 查看最近 200 行"
    return 0
}

do_alert_log() {
    local n="$1" f
    if [ ! -d "$LOG_DIR" ]; then
        printf '%s\n' "暂无告警记录 (未触发过任何告警即为正常)"
        return 0
    fi
    f=$(ls -1t "$LOG_DIR"/alert-*.log 2>/dev/null | head -1)
    if [ -z "$f" ]; then
        printf '%s\n' "暂无告警记录 (未触发过任何告警即为正常)"
        return 0
    fi
    printf '%s\n' "告警日志: $f"
    tail -n "$n" "$f" 2>/dev/null
    return 0
}

do_today() {
    local f="$LOG_DIR/collect-$(date +%Y-%m-%d).csv"
    if [ ! -f "$f" ]; then
        printf '%s\n' "今日暂无采集数据 ($f)"
        return 0
    fi
    printf '%s\n' "=== 今日汇总 ($(date +%Y-%m-%d)) ==="
    awk -F, '
    function hb(v,   r, u) {
        if (v >= 1099511627776) { r = v % 1099511627776; u = v / 1099511627776; return sprintf("%d.%dTB", u, r * 10 / 1099511627776) }
        if (v >= 1073741824) { r = v % 1073741824; u = v / 1073741824; return sprintf("%d.%dGB", u, r * 10 / 1073741824) }
        if (v >= 1048576) { r = v % 1048576; u = v / 1048576; return sprintf("%d.%dMB", u, r * 10 / 1048576) }
        if (v >= 1024) { r = v % 1024; u = v / 1024; return sprintf("%d.%dKB", u, r * 10 / 1024) }
        return sprintf("%dB", v)
    }
    NR > 1 {
        rx += $16 + 0; tx += $17 + 0
        if ($8 + 0 > pkd) pkd = $8 + 0
        if ($9 + 0 > pku) pku = $9 + 0
        if ($4 + 0 > pkc) pkc = $4 + 0
        if ($7 + 0 > pkl) pkl = $7 + 0
        if ($10 + 0 > pkt) pkt = $10 + 0
        scpu += $4 + 0; sload += $7 + 0; n++
        if (n == 1) first = $1
        last = $1
    }
    END {
        if (n == 0) { print "  无有效样本"; exit }
        printf "  采集时段    %s ~ %s  (%d 个样本)\n", first, last, n
        printf "  总流量      下行 %s   上行 %s   合计 %s\n", hb(rx), hb(tx), hb(rx + tx)
        printf "  峰值带宽    下行 %s/s   上行 %s/s\n", hb(pkd), hb(pku)
        printf "  平均 CPU    %.1f%%      峰值 CPU %.1f%%\n", scpu / n, pkc
        printf "  平均负载    %.2f       峰值负载 %.2f\n", sload / n, pkl
        printf "  连接数峰值  %d\n", pkt
    }' "$f"
    return 0
}

month_files() {
    # 输出本计量周期内的所有采集文件
    local ps="$1" f d
    for f in "$LOG_DIR"/collect-*.csv "$LOG_DIR"/collect-*.csv.gz; do
        [ -e "$f" ] || continue
        d=${f##*/collect-}
        d=${d%%.csv*}
        case "$d" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
            *) continue ;;
        esac
        if [ "$(d2n $(split_date "$d"))" -ge "$(d2n $(split_date "$ps"))" ] 2>/dev/null; then
            printf '%s\n' "$f"
        fi
    done
}

do_month() {
    local ps de dim
    ps=$(period_start "${ST_RESET_DAY:-1}")
    [ -n "$ST_PERIOD_START" ] && ps=$ST_PERIOD_START
    printf '%s\n' "=== 本月汇总 (计量周期 $ps 起, 重置日 $ST_RESET_DAY) ==="
    [ -d "$LOG_DIR" ] || { printf '%s\n' "  暂无采集数据"; return 0; }
    local files
    files=$(month_files "$ps")
    if [ -z "$files" ]; then
        printf '%s\n' "  本周期暂无采集数据"
    else
        printf '%s\n' "$files" | while IFS= read -r f; do
            case "$f" in
                *.gz) gzip -dc "$f" 2>/dev/null ;;
                *)    cat "$f" 2>/dev/null ;;
            esac
        done | awk -F, '
        function hb(v,   r, u) {
            if (v >= 1099511627776) { r = v % 1099511627776; u = v / 1099511627776; return sprintf("%d.%dTB", u, r * 10 / 1099511627776) }
            if (v >= 1073741824) { r = v % 1073741824; u = v / 1073741824; return sprintf("%d.%dGB", u, r * 10 / 1073741824) }
            if (v >= 1048576) { r = v % 1048576; u = v / 1048576; return sprintf("%d.%dMB", u, r * 10 / 1048576) }
            if (v >= 1024) { r = v % 1024; u = v / 1024; return sprintf("%d.%dKB", u, r * 10 / 1024) }
            return sprintf("%dB", v)
        }
        $1 != "" && NF >= 17 {
            rx += $16 + 0; tx += $17 + 0
            if ($8 + 0 > pkd) pkd = $8 + 0
            if ($9 + 0 > pku) pku = $9 + 0
            if ($7 + 0 > pkl) pkl = $7 + 0
            if ($4 + 0 > pkc) pkc = $4 + 0
            scpu += $4 + 0; sload += $7 + 0; n++
        }
        END {
            if (n == 0) { print "  无有效样本"; exit }
            printf "  样本数      %d\n", n
            printf "  周期总流量  下行 %s   上行 %s   合计 %s\n", hb(rx), hb(tx), hb(rx + tx)
            printf "  峰值带宽    下行 %s/s   上行 %s/s\n", hb(pkd), hb(pku)
            printf "  平均/峰值负载  %.2f / %.2f\n", sload / n, pkl
            printf "  平均/峰值CPU   %.1f%% / %.1f%%\n", scpu / n, pkc
        }'
    fi
    if [ "${ST_QUOTA:-0}" -gt 0 ] 2>/dev/null; then
        de=$(days_elapsed "$ps")
        dim=$(days_in_month "$(date +%Y)" "$(( 10#$(date +%m) ))")
        printf '  配额        %s   已过 %s / %s 天\n' "$(human_bytes "$ST_QUOTA")" "$de" "$dim"
    fi
    return 0
}

do_history() {
    local h="${STATE_FILE%/*}/history" n="${1:-12}"
    if [ ! -f "$h" ]; then
        printf '%s\n' "暂无历史归档 (每个计量周期结束时自动记录)"
        return 0
    fi
    printf '%s\n' "=== 历史流量归档 (最近 $n 个周期) ==="
    tail -n "$n" "$h" | awk -F, '
    function hb(v,   r, u) {
        if (v >= 1099511627776) { r = v % 1099511627776; u = v / 1099511627776; return sprintf("%d.%dTB", u, r * 10 / 1099511627776) }
        if (v >= 1073741824) { r = v % 1073741824; u = v / 1073741824; return sprintf("%d.%dGB", u, r * 10 / 1073741824) }
        if (v >= 1048576) { r = v % 1048576; u = v / 1048576; return sprintf("%d.%dMB", u, r * 10 / 1048576) }
        if (v >= 1024) { r = v % 1024; u = v / 1024; return sprintf("%d.%dKB", u, r * 10 / 1024) }
        return sprintf("%dB", v)
    }
    { printf "  %s   下行 %s   上行 %s   合计 %s\n", $1, hb($2), hb($3), hb($2 + $3) }'
    return 0
}


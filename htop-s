#===============================================================================
ST_PASS=0
ST_FAIL=0

assert_eq() {
    local name="$1" exp="$2" act="$3"
    if [ "$exp" = "$act" ]; then
        ST_PASS=$(( ST_PASS + 1 ))
        printf '  %s[PASS]%s %s\n' "$C_GREEN" "$C_RESET" "$name"
    else
        ST_FAIL=$(( ST_FAIL + 1 ))
        printf '  %s[FAIL]%s %s  期望[%s] 实际[%s]\n' "$C_RED" "$C_RESET" "$name" "$exp" "$act"
    fi
}

do_selftest() {
    printf '%s\n' "$(hr_line 70)"
    printf '  %s\n' "$(bold "$PROG 内置自测 v$VERSION")"
    printf '%s\n' "$(hr_line 70)"

    # 1. bash 3.2 兼容性静态扫描
    printf '\n  %s\n' "$(bold "1. bash 3.2 兼容性扫描")"
    local self targets found="" hits
    self=$(resolve_self)
    if [ -r "$self" ]; then
        # 扫描时排除含 HT_S_SCAN 标记的清单行本身, 以及纯注释行
        for targets in 'declare -A' 'mapfile' 'readarray' '\$\{[A-Za-z_][A-Za-z0-9_]*\^\^\}' '\$\{[A-Za-z_][A-Za-z0-9_]*,,}' '&>>' 'date +%s%N' 'local -n' '[A-Za-z_][A-Za-z0-9_]*\[[^]]+\]\[' ; do # HT_S_SCAN
            hits=$(grep -nE -- "$targets" "$self" 2>/dev/null | grep -v 'HT_S_SCAN' | grep -vE '^[0-9]+:[[:space:]]*#')
            [ -n "$hits" ] && found="${found}${found:+, }${targets}"
        done
        if [ -z "$found" ]; then
            assert_eq "无 bash4 专有语法" "clean" "clean"
        else
            assert_eq "无 bash4 专有语法" "clean" "$found"
        fi
    else
        printf '  %s[SKIP]%s 无法定位脚本自身, 跳过静态扫描\n' "$C_DIM" "$C_RESET"
    fi

    # 2. 单位换算
    printf '\n  %s\n' "$(bold "2. 单位换算")"
    assert_eq "human_bytes 0"      "0B"     "$(human_bytes 0)"
    assert_eq "human_bytes 1023"   "1023B"  "$(human_bytes 1023)"
    assert_eq "human_bytes 1024"   "1.0KB"  "$(human_bytes 1024)"
    assert_eq "human_bytes 1536"   "1.5KB"  "$(human_bytes 1536)"
    assert_eq "human_bytes 1048576" "1.0MB" "$(human_bytes 1048576)"
    assert_eq "human_bytes 1073741824" "1.0GB" "$(human_bytes 1073741824)"
    assert_eq "human_bytes 非数字" "0B" "$(human_bytes "abc")"
    assert_eq "human_bytes 负数" "-1.0KB" "$(human_bytes -1024)"

    # 3. 进度条
    printf '\n  %s\n' "$(bold "3. 进度条")"
    local oldascii="$USE_ASCII"
    USE_ASCII=1
    assert_eq "bar 0%   宽度10" "----------" "$(bar 0 10)"
    assert_eq "bar 50%  宽度10" "#####-----" "$(bar 50 10)"
    assert_eq "bar 100% 宽度10" "##########" "$(bar 100 10)"
    assert_eq "bar 超界 150%"   "##########" "$(bar 150 10)"
    assert_eq "bar 负数 -50%"   "----------" "$(bar -50 10)"
    USE_ASCII=$oldascii

    # 4. 日期算术
    printf '\n  %s\n' "$(bold "4. 日期算术 (纯 shell, 不依赖 date -d)")"
    assert_eq "闰年 2024-02" "29" "$(days_in_month 2024 2)"
    assert_eq "平年 2026-02" "28" "$(days_in_month 2026 2)"
    assert_eq "世纪闰年 2000-02" "29" "$(days_in_month 2000 2)"
    assert_eq "非闰 1900-02" "28" "$(days_in_month 1900 2)"
    assert_eq "31 天月份" "31" "$(days_in_month 2026 1)"
    assert_eq "30 天月份" "30" "$(days_in_month 2026 4)"
    local d1 d2
    d1=$(d2n 2026 1 1); d2=$(d2n 2025 12 31)
    assert_eq "跨年天序号差" "1" "$(( d1 - d2 ))"
    d1=$(d2n 2026 3 1); d2=$(d2n 2026 2 28)
    assert_eq "平年 2月28->3月1" "1" "$(( d1 - d2 ))"
    d1=$(d2n 2024 3 1); d2=$(d2n 2024 2 28)
    assert_eq "闰年 2月28->3月1" "2" "$(( d1 - d2 ))"

    # 5. CPU 差分
    printf '\n  %s\n' "$(bold "5. CPU 差分计算")"
    local cd
    cd=$(cpu_delta "200 0 100 2000 20 0 0 0" "100 0 50 1000 10 0 0 0")
    assert_eq "busy%" "12.9" "$(printf '%s' "$cd" | awk '{print $1}')"
    assert_eq "user%" "8.6"  "$(printf '%s' "$cd" | awk '{print $2}')"
    assert_eq "sys%"  "4.3"  "$(printf '%s' "$cd" | awk '{print $3}')"
    assert_eq "io%"   "0.9"  "$(printf '%s' "$cd" | awk '{print $4}')"
    cd=$(cpu_delta "100 0 50 1000 10 0 0 0" "100 0 50 1000 10 0 0 0")
    assert_eq "无变化时归零" "0.0" "$(printf '%s' "$cd" | awk '{print $1}')"
    cd=$(cpu_delta "" "")
    assert_eq "空输入不报错" "0.0" "$(printf '%s' "$cd" | awk '{print $1}')"

    # 6. 曲线
    printf '\n  %s\n' "$(bold "6. 带宽曲线")"
    oldascii="$USE_ASCII"; USE_ASCII=1
    local sp
    sp=$(sparkline "0 1 2 3 4 5 6 7" 8 7)
    assert_eq "长度正确" "8" "$(printf '%s' "$sp" | wc -c | tr -d ' ')"
    sp=$(sparkline "5 5 5" 10 10)
    assert_eq "不足宽度不补位" "3" "$(printf '%s' "$sp" | wc -c | tr -d ' ')"
    sp=$(sparkline "" 10 10)
    assert_eq "空输入" "0" "$(printf '%s' "$sp" | wc -c | tr -d ' ')"

    # 非 ASCII 模式下每个曲线字符必须完整输出。
    # 8 个字符 × 3 字节 = 24 字节; 若 awk 按【字节】索引 substr (mawk),
    # 只会取到 8 个孤立的字节 => 8 字节, 并产出非法 UTF-8。
    USE_ASCII=0
    sp=$(sparkline "0 1 2 3 4 5 6 7" 8 7)
    assert_eq "非ASCII 输出完整字符(24字节)" "24" "$(printf '%s' "$sp" | wc -c | tr -d ' ')"
    USE_ASCII=$oldascii

    # 7. TCP 解析 (构造测试夹具)
    printf '\n  %s\n' "$(bold "7. /proc/net/tcp 解析")"
    local mnet="$TMPD/tnet"
    mkdir -p "$mnet/net" 2>/dev/null
    cat > "$mnet/net/tcp" <<'TCPEOF'
  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode
   0: 0100007F:0035 00000000:0000 0A 00000000:00000000 00:00000000 00000000   102        0 11111 1 0000:000000 100 0
   1: 0100007F:1F90 0A00A8C0:01BB 01 00000000:00000000 00:00000000 00000000  1000        0 22222 1 0000:000000 100 0
   2: 0100007F:1F90 0A00A8C0:01BC 01 00000000:00000000 00:00000000 00000000  1000        0 22222 1 0000:000000 100 0
   3: 0100007F:0050 00000000:0000 0A 00000000:00000000 00:00000000 00000000     0        0 33333 1 0000:000000 100 0
TCPEOF
    local saved_proc="$PROC_ROOT"
    PROC_ROOT="$mnet"
    local tcpout stat line
    tcpout=$(conn_scan)
    stat=$(printf '%s\n' "$tcpout" | awk '$1 == "STAT" {print $2, $3, $4, $5, $11}')
    assert_eq "总数/EST/SYN/SYN_RECV/LISTEN" "4 2 0 0 2" "$stat"
    line=$(printf '%s\n' "$tcpout" | awk '$1 == "PEER" {print $3; exit}')
    assert_eq "对端 IP 小端序解码" "192.168.0.10" "$line"
    line=$(printf '%s\n' "$tcpout" | awk '$1 == "PORT" {print $3}' | sort -n | tr '\n' ' ' | sed 's/ $//')
    assert_eq "监听端口十六进制解码" "53 80" "$line"
    PROC_ROOT="$saved_proc"

    # 8. 负载解析 (第 4 字段是 运行/总数 的坑)
    printf '\n  %s\n' "$(bold "8. 负载与进程数解析")"
    printf '1.24 0.98 0.71 3/512 12345\n' > "$TMPD/loadavg"
    local oldproc2="$PROC_ROOT"
    PROC_ROOT="$TMPD"
    local ld
    ld=$(read_loadavg)
    assert_eq "load1" "1.24" "$(printf '%s' "$ld" | awk '{print $1}')"
    assert_eq "运行中进程数" "3" "$(printf '%s' "$ld" | awk '{print $4}')"
    assert_eq "总进程数" "512" "$(printf '%s' "$ld" | awk '{print $5}')"
    PROC_ROOT="$oldproc2"

    # 9. 网卡解析
    printf '\n  %s\n' "$(bold "9. 网卡流量解析")"
    local mdev="$TMPD/devnet"
    mkdir -p "$mdev" 2>/dev/null
    cat > "$mdev/dev" <<'DEVEOF'
Inter-|   Receive                                                |  Transmit
 face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed
    lo: 1000       10    0    0    0     0          0         0     1000       10    0    0    0     0       0          0
  eth0: 5000000   4000    3    7    0     0          0         0  2000000     3000   2    5    0     0       0          0
eth0.100: 999      10    0    0    0     0          0         0      111       10    0    0    0     0       0          0
DEVEOF
    oldproc2="$PROC_ROOT"
    local savediface="$IFACE_LIST"
    PROC_ROOT="$TMPD"
    # 需要把 net/dev 放到 net 子目录
    mkdir -p "$TMPD/net" 2>/dev/null
    cp "$mdev/dev" "$TMPD/net/dev" 2>/dev/null
    IFACE_LIST="eth0"
    local nv
    nv=$(net_read)
    assert_eq "eth0 精确匹配(不误配 eth0.100)" "5000000 2000000 3 2 7 5" "$nv"
    IFACE_LIST="eth0 eth0.100"
    nv=$(net_read)
    assert_eq "多网卡求和" "5000999 2000111 3 2 7 5" "$nv"
    IFACE_LIST="$savediface"
    PROC_ROOT="$oldproc2"

    # 10. 路径与安全
    printf '\n  %s\n' "$(bold "10. 其他")"
    assert_eq "状态文件路径按身份隔离" "yes" "$([ -n "$STATE_FILE" ] && echo yes || echo no)"
    assert_eq "nft 表名固定" "htop_s" "htop_s"
    assert_eq "PID 复用防护字段存在" "yes" "$(grep -q 'starttime' "$self" 2>/dev/null && echo yes || echo no)"

    # 11. i18n 变量完整性 (旧版崩溃的根因就是未定义变量)
    printf '\n  %s\n' "$(bold "11. i18n 变量完整性 (set -u 防护)")"
    if [ -r "$self" ]; then
        local miss
        grep -oE '\$\{?T_[A-Z0-9_]+' "$self" 2>/dev/null | sed 's/^\${\?//' | sort -u > "$TMPD/ref.txt"
        grep -oE '(^|[[:space:];|{])T_[A-Z0-9_]+=' "$self" 2>/dev/null | sed 's/.*\(T_[A-Z0-9_]*\)=/\1/' | sort -u > "$TMPD/def.txt"
        miss=$(comm -23 "$TMPD/ref.txt" "$TMPD/def.txt" 2>/dev/null | tr '\n' ' ')
        miss=$(printf '%s' "$miss" | sed 's/[[:space:]]*$//')
        assert_eq "所有 T_ 变量均有定义" "" "$miss"
    else
        printf '  %s[SKIP]%s 无法定位脚本自身\n' "$C_DIM" "$C_RESET"
    fi

    # 12. 默认网关解析 (/proc/net/route 同为小端序存储)
    printf '\n  %s\n' "$(bold "12. 默认网关解析")"
    local mrt="$TMPD/rt"
    mkdir -p "$mrt/net" 2>/dev/null
    printf 'Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n' > "$mrt/net/route"
    printf 'eth0\t0000A8C0\t00000000\t0001\t0\t0\t100\t00FFFFFF\t0\t0\t0\n' >> "$mrt/net/route"
    printf 'eth0\t00000000\t0100A8C0\t0003\t0\t0\t100\t00000000\t0\t0\t0\n' >> "$mrt/net/route"
    local saved_p="$PROC_ROOT"
    PROC_ROOT="$mrt"
    assert_eq "网关小端序解码" "192.168.0.1" "$(read_gateway)"
    PROC_ROOT="$TMPD"
    assert_eq "无 route 文件时为空" "" "$(read_gateway)"
    PROC_ROOT="$saved_p"

    # 13. 进程排序键 n / i (构造映射, 不依赖具体 pid, 真实机器同样可跑)
    printf '\n  %s\n' "$(bold "13. 进程排序键 n / i")"
    local pid_a="" pid_b="" d topn topi
    for d in "$PROC_ROOT"/[0-9]*; do
        [ -r "$d/stat" ] || continue
        if [ -z "$pid_a" ]; then
            pid_a=${d##*/}
        elif [ -z "$pid_b" ]; then
            pid_b=${d##*/}
            break
        fi
    done
    if [ -n "$pid_a" ] && [ -n "$pid_b" ]; then
        CV_MEM_TOTAL=16384000
        MV_CONNMAP="$(printf '%s 42\n%s 5' "$pid_a" "$pid_b")"
        MV_IOMAP="$(printf '%s 2097152\n%s 1048576' "$pid_b" "$pid_a")"
        proc_top "c" 1 >/dev/null 2>&1          # 首次调用建立差分基准
        topn=$(proc_top "n" 1 2>/dev/null | head -1)
        topi=$(proc_top "i" 1 2>/dev/null | head -1)
        assert_eq "n 排序按连接数降序" "$pid_a" "$(printf '%s' "$topn" | awk -F'|' '{print $3}')"
        assert_eq "n 模式指标列=连接数" "42" "$(printf '%s' "$topn" | awk -F'|' '{print $7}')"
        assert_eq "i 排序按 IO 降序" "$pid_b" "$(printf '%s' "$topi" | awk -F'|' '{print $3}')"
        assert_eq "i 模式指标列已格式化" "2.0MB/s" "$(printf '%s' "$topi" | awk -F'|' '{print $7}')"
    else
        printf '  %s[SKIP]%s 可读进程不足 2 个, 跳过排序键测试\n' "$C_DIM" "$C_RESET"
    fi

    printf '\n%s\n' "$(hr_line 70)"
    if [ "$ST_FAIL" = "0" ]; then
        printf '  %s%s%d 项全部通过%s\n' "$C_GREEN" "$C_BOLD" "$ST_PASS" "$C_RESET"
    else
        printf '  %s通过 %d 项, 失败 %d 项%s\n' "$C_RED" "$ST_PASS" "$ST_FAIL" "$C_RESET"
    fi
    printf '%s\n' "$(hr_line 70)"
    [ "$ST_FAIL" = "0" ] && return 0
    return 1
}


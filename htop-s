# 挑选临时目录: 尊重 TMPDIR, 但必须以"实际写入"验证可用; 否则退回标准路径
pick_tmp() {
    local d t
    for d in "${TMPDIR:-}" /tmp /var/tmp .; do
        [ -n "$d" ] || continue
        [ -d "$d" ] || continue
        t="${d%/}/${PROG}.wtest.$$"
        if (umask 077; : > "$t") 2>/dev/null; then
            rm -f "$t" 2>/dev/null
            printf '%s' "${d%/}"
            return 0
        fi
    done
    printf '%s' "."
}

is_num() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

#===============================================================================
# 4. 单位与格式 (纯 shell, 不 fork)
#===============================================================================
human_bytes() {
    local n="${1:-0}" neg="" r
    case "$n" in -*) neg="-"; n=${n#-} ;; esac
    is_num "$n" || n=0
    if   [ "$n" -ge 1099511627776 ]; then r=$(( n % 1099511627776 )); n=$(( n / 1099511627776 )); r=$(( r * 10 / 1099511627776 )); printf '%s%d.%dTB' "$neg" "$n" "$r"
    elif [ "$n" -ge 1073741824 ];    then r=$(( n % 1073741824 ));    n=$(( n / 1073741824 ));    r=$(( r * 10 / 1073741824 ));    printf '%s%d.%dGB' "$neg" "$n" "$r"
    elif [ "$n" -ge 1048576 ];       then r=$(( n % 1048576 ));       n=$(( n / 1048576 ));       r=$(( r * 10 / 1048576 ));       printf '%s%d.%dMB' "$neg" "$n" "$r"
    elif [ "$n" -ge 1024 ];          then r=$(( n % 1024 ));          n=$(( n / 1024 ));          r=$(( r * 10 / 1024 ));          printf '%s%d.%dKB' "$neg" "$n" "$r"
    else printf '%s%dB' "$neg" "$n"
    fi
}

human_rate() { human_bytes "${1:-0}"; printf '/s'; }

human_size_from_kb() { human_bytes "$(( ${1:-0} * 1024 ))"; }

fmt_uptime() {
    local s="${1:-0}" d h m
    is_num "${s%%.*}" || s=0
    s=${s%%.*}
    d=$(( s / 86400 )); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
    if [ "$OUT_LANG" = "en" ]; then printf '%dd %dh %dm' "$d" "$h" "$m"
    else printf '%d天%d小时%d分' "$d" "$h" "$m"; fi
}

pct_color() {
    local p="${1:-0}"
    is_num "${p%%.*}" || p=0
    p=${p%%.*}
    if [ "$p" -ge 85 ]; then printf '%s' "$C_RED"
    elif [ "$p" -ge 60 ]; then printf '%s' "$C_YELLOW"
    else printf '%s' "$C_GREEN"; fi
}

bar() {
    local pct="${1:-0}" width="${2:-20}" filled i out=""
    is_num "${pct%%.*}" || pct=0
    pct=${pct%%.*}
    [ "$width" -lt 1 ] && width=1
    filled=$(( pct * width / 100 ))
    [ "$filled" -gt "$width" ] && filled=$width
    [ "$filled" -lt 0 ] && filled=0
    i=0
    if [ "$USE_ASCII" = "1" ]; then
        while [ "$i" -lt "$filled" ]; do out="${out}#"; i=$(( i + 1 )); done
        while [ "$i" -lt "$width" ]; do out="${out}-"; i=$(( i + 1 )); done
    else
        while [ "$i" -lt "$filled" ]; do out="${out}█"; i=$(( i + 1 )); done
        while [ "$i" -lt "$width" ]; do out="${out}░"; i=$(( i + 1 )); done
    fi
    printf '%s' "$out"
}

hr_line() {
    local w="${1:-60}" i=0 out="" ch="-"
    [ "$USE_ASCII" = "1" ] || ch="─"
    [ "$w" -lt 1 ] && w=1
    while [ "$i" -lt "$w" ]; do out="${out}${ch}"; i=$(( i + 1 )); done
    printf '%s' "$out"
}

seg() { printf '%s%s%s' "$C_DIM" "$1" "$C_RESET"; }
bold() { printf '%s%s%s' "$C_BOLD" "$1" "$C_RESET"; }

sparkline() {
    local data="$1" width="$2" max="$3"
    awk -v d="$data" -v w="$width" -v mx="$max" -v asc="$USE_ASCII" '
    BEGIN {
        # 用显式数组而非 substr(chars, idx, 1):
        # sparkline 字符每个占 3 字节, 而 mawk 的 substr 按【字节】索引,
        # 会取到半个字符并输出非法 UTF-8; gawk 按字符索引则正常。
        # 数组元素是完整字符串字面量, 两种实现下都正确。
        if (asc == 1) {
            sc[1] = " "; sc[2] = "."; sc[3] = ":"; sc[4] = "-"
            sc[5] = "="; sc[6] = "+"; sc[7] = "*"; sc[8] = "@"
        } else {
            sc[1] = "▁"; sc[2] = "▂"; sc[3] = "▃"; sc[4] = "▄"
            sc[5] = "▅"; sc[6] = "▆"; sc[7] = "▇"; sc[8] = "█"
        }
        n = split(d, a, " ")
        if (n == 0 || w < 1) { print ""; exit }
        if (mx <= 0) mx = 1
        start = n - w + 1; if (start < 1) start = 1
        s = ""
        for (i = start; i <= n; i++) {
            v = a[i] + 0
            idx = int(v / mx * 7) + 1
            if (idx > 8) idx = 8
            if (idx < 1) idx = 1
            s = s sc[idx]
        }
        print s
    }'
}


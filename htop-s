EOF
    return 0
}

arg_err() {
    printf '%s\n' "错误: 参数 $1 缺少或格式不正确" >&2
    printf '%s\n' "用 $PROG -h 查看帮助" >&2
    exit 1
}

OPT_VAL=""
OPT_SHIFT=1

optval() {
    case "$1" in
        *=*) OPT_VAL="${1#*=}"; OPT_SHIFT=1 ;;
        *)   OPT_VAL="${2:-}";  OPT_SHIFT=2 ;;
    esac
    [ -n "$OPT_VAL" ] || return 1
    return 0
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -i|--interval|--interval=*)
                optval "$1" "${2:-}" || arg_err "$1"
                is_num "$OPT_VAL" || arg_err "$1"
                [ "$OPT_VAL" -ge 1 ] && [ "$OPT_VAL" -le 30 ] || arg_err "$1 (需 1~30)"
                INTERVAL=$OPT_VAL; CLI_INTERVAL=$OPT_VAL; shift "$OPT_SHIFT" ;;
            -I)
                optval "$1" "${2:-}" || arg_err "$1"
                CLI_IFACE=$OPT_VAL; shift "$OPT_SHIFT" ;;
            --iface|--iface=*)
                optval "$1" "${2:-}" || arg_err "$1"
                CLI_IFACE=$OPT_VAL; MODE="iface"; shift "$OPT_SHIFT" ;;
            -e|--en)     OUT_LANG="en"; shift ;;
            -a|--ascii)  USE_ASCII=1; shift ;;
            -n|--snapshot) MODE="snapshot"; shift ;;
            -m|--minimal)  MINIMAL=1; shift ;;
            -p|--ports)    OPT_PORTS=1; shift ;;
            --check-update) MODE="check-update"; shift ;;
            --update)      MODE="update"; CLI_UPDATE=""; shift ;;
            --update=*)    MODE="update"; CLI_UPDATE="${1#*=}"; shift ;;
            --force)       OPT_FORCE=1; shift ;;
            --proxy)
                optval "$1" "${2:-}" || arg_err "$1"
                CLI_PROXY=$OPT_VAL; HT_S_PROXY=$OPT_VAL; shift "$OPT_SHIFT" ;;
            --proxy=*)
                CLI_PROXY="${1#*=}"; HT_S_PROXY=$CLI_PROXY; shift ;;
            --daemon)    MODE="daemon"; shift ;;
            --install)   MODE="install"; shift ;;
            --with-motd) OPT_WITH_MOTD=1; shift ;;
            --uninstall) MODE="uninstall"; shift ;;
            --purge)     OPT_PURGE=1; shift ;;
            --upgrade)   MODE="upgrade"; shift ;;
            --start)     MODE="start"; shift ;;
            --stop)      MODE="stop"; shift ;;
            --restart)   MODE="restart"; shift ;;
            --status)    MODE="status"; shift ;;
            --ensure-acct) MODE="ensure-acct"; shift ;;
            --log|--log=*)
                MODE="log"
                optval "$1" "${2:-}" || { OPT_LOG_LINES=30; shift; continue; }
                is_num "$OPT_VAL" && OPT_LOG_LINES=$OPT_VAL; shift "$OPT_SHIFT" ;;
            --alert|--alert=*)
                MODE="alert"
                optval "$1" "${2:-}" || { OPT_ALERT_LINES=30; shift; continue; }
                is_num "$OPT_VAL" && OPT_ALERT_LINES=$OPT_VAL; shift "$OPT_SHIFT" ;;
            --history|--history=*)
                MODE="history"
                optval "$1" "${2:-}" || { OPT_HISTORY=12; shift; continue; }
                is_num "$OPT_VAL" && OPT_HISTORY=$OPT_VAL; shift "$OPT_SHIFT" ;;
            --today)     MODE="today"; shift ;;
            --month)     MODE="month"; shift ;;
            --export)    MODE="export"; shift ;;
            --quota|--quota=*)
                optval "$1" "${2:-}" || arg_err "$1"
                CLI_QUOTA=$OPT_VAL; MODE="quota"; shift "$OPT_SHIFT" ;;
            --reset-day|--reset-day=*)
                optval "$1" "${2:-}" || arg_err "$1"
                is_num "$OPT_VAL" || arg_err "$1"
                CLI_RESET_DAY=$OPT_VAL; MODE="resetday"; shift "$OPT_SHIFT" ;;
            --keep|--keep=*)
                optval "$1" "${2:-}" || arg_err "$1"
                is_num "$OPT_VAL" || arg_err "$1"
                CLI_KEEP=$OPT_VAL; MODE="keep"; shift "$OPT_SHIFT" ;;
            --config)    MODE="config"; shift ;;
            --acct|--acct=*)
                optval "$1" "${2:-}" || { MODE="acct"; OPT_VAL="status"; }
                MODE="acct"; CLI_ACCT=$OPT_VAL; shift "$OPT_SHIFT" ;;
            --check)     MODE="check"; shift ;;
            --selftest)  MODE="selftest"; shift ;;
            --test-alert) MODE="test-alert"; shift ;;
            -V|--version) printf '%s %s\n' "$PROG" "$VERSION"; exit 0 ;;
            -h|--help)   usage; exit 0 ;;
            *) printf '%s\n' "错误: 未知参数 $1" >&2; usage >&2; exit 1 ;;
        esac
    done
    # 冲突检测
    if [ "$MODE" = "uninstall" ] && [ "$OPT_PURGE" = "1" ]; then :; fi
    if [ "$MODE" = "install" ] && [ "$OPT_PURGE" = "1" ]; then
        printf '%s\n' "错误: --install 不能与 --purge 同用" >&2
        exit 1
    fi
    # --proxy 单独出现时作为命令处理, 与其他命令同时出现时作为修饰
    if [ "$MODE" = "interactive" ] && [ -n "$CLI_PROXY" ]; then
        MODE="proxy"
    fi
    return 0
}

strip_ansi() {
    awk '{ gsub(/\033\[[0-9;?]*[A-Za-z]/, ""); print }'
}

#===============================================================================
# 25. 主流程
#===============================================================================
main() {
    KEEP_DAYS=30

    parse_args "$@"
    detect_caps
    init_paths
    init_i18n
    init_colors
    state_load
    load_config

    if [ ! -d "$PROC_ROOT" ]; then
        printf '%s\n' "错误: 未找到 $PROC_ROOT, 本脚本仅支持 Linux 系统。" >&2
        exit 1
    fi

    case "$MODE" in
        selftest)   do_selftest; exit $? ;;
        version)    printf '%s %s\n' "$PROG" "$VERSION"; exit 0 ;;
    esac

    IFACE_LIST="${IFACE_LIST:-$(iface_detect)}"
    DISK_WHOLE=$(disk_whole_list)

    case "$MODE" in
        install)     do_install; exit $? ;;
        uninstall)   do_uninstall; exit $? ;;
        upgrade)     do_upgrade; exit $? ;;
        start)       svc_start; exit $? ;;
        stop)        svc_stop; exit $? ;;
        restart)     svc_restart; exit $? ;;
        status)      do_status; exit 0 ;;
        ensure-acct) do_ensure_acct; exit 0 ;;
        check-update) do_check_update; exit $? ;;
        update)      do_update "$CLI_UPDATE" "$OPT_FORCE"; exit $? ;;
        proxy)       do_set_proxy "$CLI_PROXY"; exit 0 ;;
        acct)        do_acct "${CLI_ACCT:-status}"; exit $? ;;
        log)         do_log "$OPT_LOG_LINES"; exit 0 ;;
        alert)       do_alert_log "$OPT_ALERT_LINES"; exit 0 ;;
        today)       do_today; exit 0 ;;
        month)       do_month; exit 0 ;;
        history)     do_history "$OPT_HISTORY"; exit 0 ;;
        test-alert)  do_test_alert; exit 0 ;;
        check)       do_check; exit 0 ;;
        config)      do_config_show; exit 0 ;;
        quota)
            v=$(parse_size "$CLI_QUOTA") || { printf '%s\n' "错误: 无法解析配额 $CLI_QUOTA (示例: 1024G)" >&2; exit 1; }
            ST_QUOTA=$v
            config_set quota "$CLI_QUOTA"
            ST_UPTIME_LAST=$(read_uptime)
            state_save
            printf '月流量配额已设置为 %s\n' "$(human_bytes "$ST_QUOTA")"
            printf '计量周期起始日: 每月 %s 日 (用 --reset-day 修改)\n' "$ST_RESET_DAY"
            [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ] && systemctl restart htop-s.service 2>/dev/null
            exit 0 ;;
        resetday)
            ST_RESET_DAY=$CLI_RESET_DAY
            [ "$ST_RESET_DAY" -lt 1 ] && ST_RESET_DAY=1
            [ "$ST_RESET_DAY" -gt 28 ] && ST_RESET_DAY=28
            config_set reset_day "$ST_RESET_DAY"
            ST_PERIOD_START=$(period_start "$ST_RESET_DAY")
            state_save
            printf '计量周期起始日已设置为每月 %s 日 (新周期起点: %s)\n' "$ST_RESET_DAY" "$ST_PERIOD_START"
            exit 0 ;;
        keep)
            config_set keep_days "$CLI_KEEP"
            printf '日志保留天数已设置为 %s 天\n' "$CLI_KEEP"
            exit 0 ;;
        iface)
            config_set iface "$CLI_IFACE"
            printf '默认网卡已设置为 %s\n' "$CLI_IFACE"
            exit 0 ;;
    esac

    # 需要采集的模式
    case "$MODE" in
        daemon)
            start_daemon
            exit $? ;;
        snapshot)
            SV_CORES_N=$(read_core_count)
            sample_slow
            sample_prime
            sleep 1
            sample_fast
            sample_mid
            quota_update
            if [ "$OPT_PORTS" = "1" ]; then
                MV_PORTS_ON=1
                MV_PORTS=$(port_map)
            fi
            render | strip_ansi
            exit 0 ;;
        export)
            SV_CORES_N=$(read_core_count)
            sample_slow
            sample_prime
            sleep 1
            sample_fast
            sample_mid
            quota_update
            export_snapshot
            exit 0 ;;
    esac

    # 交互模式
    if [ "$IS_TTY" != "1" ]; then
        printf '%s\n' "错误: 交互面板需要终端 (stdin/stdout 不是 tty)。" >&2
        printf '%s\n' "非交互场景请使用: $PROG -n  (单次快照)  或  $PROG --export  (CSV)" >&2
        exit 1
    fi
    SV_CORES_N=$(read_core_count)
    interactive_loop
    exit 0
}



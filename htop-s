#===============================================================================
# 24b. 版本管理与在线更新
#
# 说明: 监控功能零依赖, 但"检查更新/自我更新/一键安装"必然需要联网,
#       因此这里允许使用 curl 或 wget (缺失时只影响本模块, 不影响监控)。
#       代理优先级: --proxy 参数 > 配置文件 proxy= > 环境变量 > 无代理
#===============================================================================
# 挑选临时目录: 尊重 TMPDIR, 但必须以"实际写入"验证可用; 否则退回标准路径
pick_tmp() {
    local d t
    for d in "${TMPDIR:-}" /tmp /var/tmp .; do
        [ -n "$d" ] || continue
        [ -d "$d" ] || continue
        t="${d%/}/${PROG}.wtest.$$"
        if (umask 077; : > "$t") 2>/dev/null; then
            rm -f "$t" 2>/dev/null
            printf '%s' "${d%/}"
            return 0
        fi
    done
    printf '%s' "."
}

repo_base() { printf 'https://github.com/%s/%s' "$REPO_OWNER" "$REPO_NAME"; }
api_base()  { printf 'https://api.github.com/repos/%s/%s' "$REPO_OWNER" "$REPO_NAME"; }

http_fetch() {
    # $1=URL $2=输出文件; 失败返回非 0
    local url="$1" out="$2"
    local proxy="${CLI_PROXY:-${HT_S_PROXY:-${https_proxy:-${HTTPS_PROXY:-${all_proxy:-${ALL_PROXY:-}}}}}}"
    rm -f "$out" 2>/dev/null
    if [ "$HAS_CURL" = "1" ]; then
        if [ -n "$proxy" ]; then
            curl -fsSL --connect-timeout 10 --max-time 180 -x "$proxy" -o "$out" "$url" 2>/dev/null
        else
            curl -fsSL --connect-timeout 10 --max-time 180 -o "$out" "$url" 2>/dev/null
        fi
    elif [ "$HAS_WGET" = "1" ]; then
        if [ -n "$proxy" ]; then
            http_proxy="$proxy" https_proxy="$proxy" wget -q -T 30 -O "$out" "$url" 2>/dev/null
        else
            wget -q -T 30 -O "$out" "$url" 2>/dev/null
        fi
    else
        printf '%s\n' "错误: 需要 curl 或 wget 才能联网 (监控功能本身不需要)" >&2
        return 1
    fi
    [ -s "$out" ]
}

# 输出 1 表示 $1 比 $2 新
version_newer() {
    awk -v a="${1#v}" -v b="${2#v}" 'BEGIN {
        split(a, x, "."); split(b, y, ".")
        for (i = 1; i <= 3; i++) {
            if ((x[i] + 0) > (y[i] + 0)) { print 1; exit }
            if ((x[i] + 0) < (y[i] + 0)) { print 0; exit }
        }
        print 0
    }'
}

latest_version() {
    local tmp v
    tmp="$(pick_tmp)/${PROG}.rel.$$"
    if ! http_fetch "$(api_base)/releases/latest" "$tmp"; then
        rm -f "$tmp" 2>/dev/null
        return 1
    fi
    v=$(grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmp" 2>/dev/null \
        | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    rm -f "$tmp" 2>/dev/null
    v="${v#v}"
    [ -n "$v" ] || return 1
    printf '%s' "$v"
}

do_check_update() {
    printf '%s\n' "当前版本: v$VERSION"
    if [ "$HAS_CURL" != "1" ] && [ "$HAS_WGET" != "1" ]; then
        printf '%s\n' "无法检查更新: 本机没有 curl 也没有 wget" >&2
        return 1
    fi
    printf '%s\n' "正在查询 ${REPO_OWNER}/${REPO_NAME} ..."
    local lv
    if ! lv=$(latest_version); then
        printf '%s\n' "无法获取最新版本 (检查网络, 或用 --proxy http://host:port 指定代理)" >&2
        return 1
    fi
    printf '%s\n' "线上版本: v$lv"
    if [ "$lv" = "$VERSION" ]; then
        printf '%s\n' "已是最新版本"
    elif [ "$(version_newer "$lv" "$VERSION")" = "1" ]; then
        printf '%s\n' "发现新版本, 更新命令: sudo $PROG --update"
    else
        printf '%s\n' "当前版本比线上更新 (本地开发版), 无需更新"
    fi
    return 0
}

do_update() {
    local want="${1:-}" force="${2:-0}" url tmp got bak
    if [ "$(id -u 2>/dev/null || echo 1)" != "0" ]; then
        printf '%s\n' "错误: --update 需要 root 权限 (要写入 $BIN_PATH)" >&2
        printf '%s\n' "或改用一键安装:" >&2
        printf '%s\n' "  curl -fsSL $(repo_base)/releases/latest/download/install.sh | sudo bash" >&2
        return 1
    fi
    if [ "$HAS_CURL" != "1" ] && [ "$HAS_WGET" != "1" ]; then
        printf '%s\n' "错误: 需要 curl 或 wget" >&2
        return 1
    fi

    if [ -z "$want" ]; then
        printf '%s\n' "正在查询最新版本 ..."
        if ! want=$(latest_version); then
            printf '%s\n' "错误: 无法获取最新版本 (检查网络或 --proxy 设置)" >&2
            return 1
        fi
    fi
    want="${want#v}"

    if [ "$want" = "$VERSION" ] && [ "$force" != "1" ]; then
        printf '%s\n' "当前已是 v$VERSION, 无需更新 (加 --force 可强制重装)"
        return 0
    fi

    url="$(repo_base)/releases/download/v${want}/${PROG}"
    tmp="$(pick_tmp)/${PROG}.new.$$"
    printf '%s\n' "正在下载 v$want ..."
    printf '%s\n' "  $url"
    if ! http_fetch "$url" "$tmp"; then
        printf '%s\n' "错误: 下载失败 (检查网络或 --proxy 设置)" >&2
        rm -f "$tmp" 2>/dev/null
        return 1
    fi

    # 保护 1: 必须是通过语法检查的 shell 脚本
    if ! bash -n "$tmp" 2>/dev/null; then
        printf '%s\n' "错误: 下载内容未通过语法校验, 已中止 (未做任何修改)" >&2
        rm -f "$tmp" 2>/dev/null
        return 1
    fi
    # 保护 2: 文件内版本号必须与请求版本一致
    got=$(awk -F'"' '/^VERSION=/{print $2; exit}' "$tmp" 2>/dev/null)
    if [ -z "$got" ]; then
        printf '%s\n' "错误: 下载内容缺少 VERSION 声明, 已中止" >&2
        rm -f "$tmp" 2>/dev/null
        return 1
    fi
    if [ "$got" != "$want" ]; then
        printf '%s\n' "错误: 下载文件版本号为 $got, 与请求的 $want 不符, 已中止" >&2
        rm -f "$tmp" 2>/dev/null
        return 1
    fi

    # 保护 3: 覆盖前备份
    mkdir -p "${BIN_PATH%/*}" 2>/dev/null
    if [ -f "$BIN_PATH" ]; then
        bak="$BIN_PATH.bak"
        cp "$BIN_PATH" "$bak" 2>/dev/null
    fi
    if ! cp "$tmp" "$BIN_PATH" 2>/dev/null; then
        printf '%s\n' "错误: 无法写入 $BIN_PATH" >&2
        rm -f "$tmp" 2>/dev/null
        return 1
    fi
    chmod 755 "$BIN_PATH" 2>/dev/null
    rm -f "$tmp" 2>/dev/null

    printf '%s\n' "更新完成: v$VERSION -> v$want"
    [ -n "${bak:-}" ] && printf '%s\n' "旧版已备份: $bak"
    if [ "$HAS_SYSTEMCTL" = "1" ] && [ -f "$SERVICE_FILE" ]; then
        systemctl daemon-reload 2>/dev/null
        systemctl restart htop-s.service 2>/dev/null && printf '%s\n' "后台服务已重启"
    fi
    printf '%s\n' "查看版本: $PROG -V"
    return 0
}

do_set_proxy() {
    local p="$1"
    if [ -z "$p" ]; then
        printf '%s\n' "当前下载代理: ${HT_S_PROXY:-未设置}"
        printf '%s\n' "设置方法: $PROG --proxy http://127.0.0.1:10808"
        return 0
    fi
    case "$p" in
        none|off|'') config_set proxy "" ; HT_S_PROXY=""
            printf '%s\n' "已清除下载代理" ; return 0 ;;
    esac
    if ! printf '%s' "$p" | grep -qE '^[a-zA-Z0-9]+://'; then
        p="http://$p"
    fi
    config_set proxy "$p"
    HT_S_PROXY="$p"
    printf '%s\n' "下载代理已设置为 $p"
    printf '%s\n' "该代理仅用于 --check-update / --update / 一键安装, 监控功能不受影响"
    return 0
}
main "$@"

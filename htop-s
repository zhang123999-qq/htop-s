detect_caps() {
    [ -t 1 ] && command -v tput >/dev/null 2>&1 && HAS_TPUT=1
    command -v nft >/dev/null 2>&1 && HAS_NFT=1
    command -v systemctl >/dev/null 2>&1 && HAS_SYSTEMCTL=1
    command -v flock >/dev/null 2>&1 && HAS_FLOCK=1
    command -v gzip >/dev/null 2>&1 && HAS_GZIP=1
    command -v sort >/dev/null 2>&1 && HAS_SORT=1
    command -v readlink >/dev/null 2>&1 && HAS_READLINK=1
    command -v curl >/dev/null 2>&1 && HAS_CURL=1
    command -v wget >/dev/null 2>&1 && HAS_WGET=1
    command -v ping >/dev/null 2>&1 && HAS_PING=1
    command -v stty >/dev/null 2>&1 && HAS_STTY=1
    local v
    v=$(getconf PAGESIZE 2>/dev/null)
    is_num "${v:-}" && PAGESIZE=$v
    v=$(getconf CLK_TCK 2>/dev/null)
    is_num "${v:-}" && CLK_TCK=$v
    [ -t 0 ] && [ -t 1 ] && IS_TTY=1
}

